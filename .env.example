# ─────────────────────────────────────────────────────────────────────────────
# Sistema Conquista Park — variáveis de ambiente
#
# Copie para .env e preencha. Este arquivo vai para o Git: NUNCA coloque aqui
# senha, chave ou token reais.
# ─────────────────────────────────────────────────────────────────────────────

# Endereço público do sistema (links nos e-mails). Em produção precisa ser https://
APP_URL="http://localhost:3000"

# Parque vendido pelo site público desta instalação (slug cadastrado no banco).
PARK_SLUG=conquista-park

# ─── Banco de dados ──────────────────────────────────────────────────────────
# Local: rode `npm run db:local` — os valores abaixo são os do Postgres local.
# Supabase:
#   DATABASE_URL = pooler em modo transação (porta 6543) — usado pela aplicação
#   DIRECT_URL   = conexão direta ou pooler em modo sessão (porta 5432) — usado nas migrations
DATABASE_URL="postgresql://postgres:postgres-local@127.0.0.1:54329/sistemapark_dev"
DIRECT_URL="postgresql://postgres:postgres-local@127.0.0.1:54329/sistemapark_dev"
SHADOW_DATABASE_URL="postgresql://postgres:postgres-local@127.0.0.1:54329/sistemapark_shadow"
DB_POOL_MAX=10

# ─── Logs ────────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ─── E-mail ──────────────────────────────────────────────────────────────────
# mock   = não envia; mostra a mensagem no terminal (só desenvolvimento)
# resend = envia pela Resend (exige RESEND_API_KEY e domínio verificado)
EMAIL_PROVIDER=mock
EMAIL_FROM="Conquista Park <nao-responda@seudominio.com.br>"
RESEND_API_KEY=

# ─── Pagamentos ──────────────────────────────────────────────────────────────
# mock = pagamento simulado, só para desenvolvimento. Em produção, sem provedor
# real configurado, o site não aceita compras.
PAYMENT_PROVIDER=mock

# ─── Chaves do sistema ───────────────────────────────────────────────────────
# Obrigatórias em produção, com pelo menos 32 caracteres cada.
# Gere cada uma com:  openssl rand -base64 48
# Guarde uma cópia fora do servidor: sem a chave de QR os ingressos já emitidos
# deixam de ser validados; sem a de CPF, a busca de clientes por CPF.
QR_SIGNING_KEY=
ORDER_LINK_KEY=
CPF_HASH_KEY=
CRON_SECRET=
